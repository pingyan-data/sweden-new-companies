# Copy to .env (gitignored) and fill in. Load locally with:
#   set -a; source .env; set +a
# In GitHub these live in Settings → Secrets and variables → Actions.

# Secret: from the email "Anslutningsuppgifter för Värdefulla datamängder"
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=

# Variable: link behind "bolagsverket_bulkfil.zip" on Bolagsverket's
# "Nedladdningsbara filer" page (right-click → Copy link address)
BOLAGSVERKET_BULK_URL=

# Optional
# API_ORG_FORMS=AB
# MAX_API_LOOKUPS=300
# WINDOW_DAYS=35
# RUN_DATE=2026-10-27
